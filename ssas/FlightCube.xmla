                          <xs:element name="PassengerLabel" msdata:ReadOnly="true" msprop:DbColumnName="PassengerLabel" msprop:ComputedColumnExpression="CAST(PassengerKey AS NVARCHAR(10))" msprop:IsLogical="True" minOccurs="0">
