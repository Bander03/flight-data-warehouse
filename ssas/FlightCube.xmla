                          <xs:element name="SpringFestivalLabel" msdata:ReadOnly="true" msprop:DbColumnName="SpringFestivalLabel" msprop:ComputedColumnExpression="CASE WHEN IsSpringFestival = 1 THEN 'Yes' ELSE 'No' END" msprop:IsLogical="True" minOccurs="0">
