          <MdxScripts>
            <MdxScript>
              <ID>MdxScript</ID>
              <Name>MdxScript</Name>
              <Commands>
                <Command>
                  <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Average Price] AS IIF([Measures].[Segment Count] = 0, NULL, [Measures].[Total Price] / [Measures].[Segment Count]), FORMAT_STRING = "#,##0.00", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Average Rate] AS IIF([Measures].[Segment Count] = 0, NULL, [Measures].[Rate Sum] / [Measures].[Segment Count]), FORMAT_STRING = "0.000", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Stopover Share] AS IIF([Measures].[Segment Count] = 0, NULL, [Measures].[Stopover Segments] / [Measures].[Segment Count]), FORMAT_STRING = "0.0%", VISIBLE = 1;</Text>
                </Command>
              </Commands>
            </MdxScript>
          </MdxScripts>
          <DefaultMeasure>[Measures].[Segment Count]</DefaultMeasure>
          <StorageMode>Molap</StorageMode>
