                          <xs:element name="GenderLabel" msdata:ReadOnly="true" msprop:DbColumnName="GenderLabel" msprop:ComputedColumnExpression="CASE Gender WHEN N'男' THEN 'Male' WHEN N'女' THEN 'Female' ELSE 'Unknown' END" msprop:IsLogical="True" minOccurs="0">
